// Cloudflare Workers Builds (connected to this repo in the Cloudflare dashboard).
// The production site runs on the VPS (see DEPLOY_VPS.md); this Worker only
// serves the static Vite build. Non-production branches are deployed with
// `npx wrangler preview`, which requires the `previews` block below.
{
  "name": "makale-blog",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
