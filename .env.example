# LENS Platform Environment Configuration
PORT=3001
NODE_ENV=production
DATA_DIR=./data
SITE_URL=https://lens.atoker.dev

# Optional: comma-separated extra CIDRs whose X-Forwarded-For may be trusted
# (useful if an additional reverse proxy / load balancer sits in front of Nginx).
# Cloudflare edge and loopback ranges are trusted automatically.
TRUSTED_PROXIES=
